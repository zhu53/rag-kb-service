# ===== App =====
APP_NAME=kb-service
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ===== Security =====
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-random-48-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== Database (W7 启用) =====
# 开发/测试默认 sqlite（无需账号密码）；真库用 mysql+pymysql（本机 W7 用 3307）
# 不填则用 core/config.py 的默认值 sqlite:///./kb_dev.db
# DATABASE_URL=mysql+pymysql://kb:密码@127.0.0.1:3307/kb_dev?charset=utf8mb4
# W12 上 pgvector 后：postgresql+psycopg://kb:密码@127.0.0.1:5432/kb

# ===== Redis (W10 启用) =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM (W12 启用) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
